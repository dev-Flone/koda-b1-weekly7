
@baseUrl = http://localhost:5224

# Sesuaikan dengan ID wallet yang tersedia di database.
@userId = 42
@walletId = 21
@receiverWalletId = 22
@topUpId = 31
@transactionId = 15
@referenceNo = SEED-TRANSFER-001

###############################################################################
# USERS
###############################################################################

### Get all users
GET {{baseUrl}}/api/Users
Accept: application/json

### Get user by ID
GET {{baseUrl}}/api/Users/{{userId}}
Accept: application/json

### Create user
# Wallet akan dibuat otomatis oleh UserService.
POST {{baseUrl}}/api/Users
Content-Type: application/json

{
  "userName": "testuser01",
  "fullName": "Test User",
  "email": "testuser01@example.com",
  "phone": "081234567890"
}

### Update user
PUT {{baseUrl}}/api/Users/{{userId}}
Content-Type: application/json

{
  "userName": "TestUser",
  "fullName": "Updated Test User",
  "email": "TestUser@example.com",
  "phone": "081231237891"
}

### Suspend user (soft delete)
# Hati-hati: user akan berubah menjadi SUSPENDED.
DELETE {{baseUrl}}/api/Users/{{userId}}
Accept: application/json

###############################################################################
# WALLETS
###############################################################################

### Get all wallets
GET {{baseUrl}}/api/wallets
Accept: application/json

### Get wallet by ID
GET {{baseUrl}}/api/wallets/{{walletId}}
Accept: application/json

### Get wallet by user ID
GET {{baseUrl}}/api/wallets/users/{{userId}}
Accept: application/json

### Get wallet by wallet number
GET {{baseUrl}}/api/wallets/number/WLT-2159775
Accept: application/json

### Get wallets by status
# Valid values: ACTIVE, FROZEN, CLOSED
GET {{baseUrl}}/api/wallets/status/ACTIVE
Accept: application/json

### Update wallet status
# Valid values: ACTIVE, FROZEN, CLOSED
PATCH {{baseUrl}}/api/wallets/{{walletId}}/status
Content-Type: application/json

{
  "status": "ACTIVE"
}

###############################################################################
# TOP UPS
###############################################################################

### Get all top-ups
GET {{baseUrl}}/api/TopUp
Accept: application/json

### Get top-up by ID
GET {{baseUrl}}/api/TopUp/{{topUpId}}
Accept: application/json

### Get top-ups by wallet ID
GET {{baseUrl}}/api/TopUp/wallet/{{walletId}}
Accept: application/json

### Create top-up
# PaymentMethodId valid: 0 or 1.
# Top-up akan dibuat dengan status PENDING.
POST {{baseUrl}}/api/TopUp
Content-Type: application/json

{
  "walletId": {{walletId}},
  "paymentMethodId": 0,
  "amount": 100000
}

### Confirm Top Up (Manual Payment Verification)
POST {{baseUrl}}/api/topup/20/confirm

###############################################################################
# TRANSFERS
###############################################################################

### Get all transfers
GET {{baseUrl}}/api/Transfer
Accept: application/json

### Get transfer by transaction ID
GET {{baseUrl}}/api/Transfer/{{transactionId}}
Accept: application/json

### Get transfers by wallet ID
GET {{baseUrl}}/api/Transfer/wallet/{{walletId}}
Accept: application/json

### Create transfer
# Amount minimum: 10000.
# Transfer langsung mengubah saldo kedua wallet.
POST {{baseUrl}}/api/Transfer
Content-Type: application/json

{
  "senderWalletId": {{walletId}},
  "receiverWalletId": {{receiverWalletId}},
  "amount": 25000,
  "description": "HTTP API transfer test"
}

###############################################################################
# TRANSACTIONS
###############################################################################

### Get all transactions
GET {{baseUrl}}/api/Transaction
Accept: application/json

### Get transaction by ID
GET {{baseUrl}}/api/Transaction/{{transactionId}}
Accept: application/json

### Get transaction by reference number
GET {{baseUrl}}/api/Transaction/reference/{{referenceNo}}
Accept: application/json

### Get transactions by wallet ID
GET {{baseUrl}}/api/Transaction/wallet/{{walletId}}
Accept: application/json

### Get transactions by status
# Valid values depend on TransactionStatus enum.
GET {{baseUrl}}/api/Transaction/status/SUCCESS
Accept: application/json

### Get transactions by type
# Valid values depend on TransactionType enum.
GET {{baseUrl}}/api/Transaction/type/TRANSFER
Accept: application/json

### Transaction history - default pagination
GET {{baseUrl}}/api/Transaction/history
Accept: application/json

### Transaction history - pagination
GET {{baseUrl}}/api/Transaction/history?page=1&pageSize=5
Accept: application/json

### Transaction history - search
GET {{baseUrl}}/api/Transaction/history?search=SEED
Accept: application/json

### Transaction history - filter by type
GET {{baseUrl}}/api/Transaction/history?type=TOPUP&status=PENDING
Accept: application/json

### Transaction history - filter by status
GET {{baseUrl}}/api/Transaction/history?status=SUCCESS
Accept: application/json

### Transaction history - date range
GET {{baseUrl}}/api/Transaction/history?startDate=2026-11-01&endDate=2026-11-21
Accept: application/json

### Transaction history - sorting
GET {{baseUrl}}/api/Transaction/history?sortBy=createdAtUtc&sortOrder=asc
Accept: application/json

### Transaction history - combined filters
GET {{baseUrl}}/api/Transaction/history?page=1&pageSize=10&type=TRANSFER&status=SUCCESS&sortBy=createdAtUtc&sortOrder=desc
Accept: application/json

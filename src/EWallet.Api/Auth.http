###############################################################################
# CURRENT USER
###############################################################################

### Get Current User (ME)
GET {{baseUrl}}/api/Auth/me
Authorization: Bearer {{login.response.body.accessToken}}

###
GET {{baseUrl}}/api/Wallets/me
Authorization: Bearer {{login.response.body.$.accessToken}}

###
GET {{baseUrl}}/api/Wallets/recipient/email/kairn@gmail.com
Authorization: Bearer {{login.response.body.$.accessToken}}

###
GET {{baseUrl}}/api/Wallets/recipient/number/WLT-21112026-66781433
Authorization: Bearer {{login.response.body.$.accessToken}}


###############################################################################
# REFRESH TOKEN
###############################################################################

### Refresh Access Token
# @name refresh
POST {{baseUrl}}/api/Auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Get Current User Using Rotated Access Token
GET {{baseUrl}}/api/Auth/me
Authorization: Bearer {{refresh.response.body.$.accessToken}}

### Reuse Old Refresh Token (Expected: 401)
# WARNING: This should revoke the entire token family.
POST {{baseUrl}}/api/Auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Try Rotated Token After Reuse Detection (Expected: 401)
POST {{baseUrl}}/api/Auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refresh.response.body.$.refreshToken}}"
}

###############################################################################
# LOGOUT
###############################################################################

### Login For Logout Test
# @name loginForLogout
POST {{baseUrl}}/api/Auth/login
Content-Type: application/json

{
  "email": "kairn@gmail.com",
  "password": "Admin#0506"
}

### Logout (Expected: 204)
POST {{baseUrl}}/api/Auth/logout
Content-Type: application/json

{
  "refreshToken": "{{loginForLogout.response.body.$.refreshToken}}"
}

### Try Refresh After Logout (Expected: 401)
POST {{baseUrl}}/api/Auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{loginForLogout.response.body.$.refreshToken}}"
}
